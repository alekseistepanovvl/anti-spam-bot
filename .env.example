FULL_RECONCILE_INTERVAL_HOURS=24
SUMMARY_CHUNK_CHARS=12000
SUMMARY_MAX_CHARS=2000
DEBOUNCE_SECONDS=5
MIN_REPLY_DELAY_SECONDS=4
MAX_REPLY_DELAY_SECONDS=10
MAX_REPLY_CHARS=1200
